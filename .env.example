# Copie este arquivo para .env antes de iniciar o servidor.
# Uma frase longa é suficiente para impedir entradas não autorizadas.
TUMACORD_SERVER_ACCESS_KEY=troque-por-uma-frase-secreta-da-turma
TUMACORD_ADMIN_USERNAME=Moontariun

# HTTPS/WSS. Use caminhos dentro de ./certs, montado como /certs.
# Só deixe vazio em uma rede privada; exposto à internet, configure os dois.
TUMACORD_TLS_CERT_FILE=
TUMACORD_TLS_KEY_FILE=

# TURN: a reserva para quando nenhum caminho direto se forma — os dois lados
# em CGNAT simétrico, sem IPv6. Deixe vazio para não usar relay nenhum.
# Suba o relay com: docker compose --profile turn up -d
TUMACORD_TURN_URLS=
TUMACORD_TURN_SECRET=
TUMACORD_TURN_REALM=
TUMACORD_TURN_PUBLIC_IP=
TUMACORD_TURN_TTL_SECONDS=28800

# Atualizar o servidor pelo painel do dono. DESLIGADO por padrão, e de
# propósito: ligar isto faz o servidor aceitar trocar o próprio código a partir
# de um clique na interface. Ele só aceita uma versão publicada no catálogo
# assinado desta instalação, conferida por ele mesmo, e só do dono — mas ainda
# assim é a ação mais perigosa do painel.
#
# Quem aplica é o EXECUTOR, que roda no host (packaging/servidor/). Sem ele,
# ligar isto faz o painel mostrar as versões e a aplicação falhar. Para ligar:
#   1. instale e suba o executor (docs/atualizacao-servidor.md);
#   2. copie o conteúdo de /var/lib/tumacord/executor/executor.token para
#      TUMACORD_EXECUTOR_TOKEN abaixo;
#   3. descomente COMPOSE_FILE, que acrescenta o socket do executor ao chat;
#   4. ponha TUMACORD_SELF_UPDATE em 1 e recrie o chat.
TUMACORD_SELF_UPDATE=0
TUMACORD_EXECUTOR_TOKEN=
# COMPOSE_FILE=docker-compose.yml:docker-compose.executor.yml


# ── Serviço de atualizações ─────────────────────────────────────────────────
#
# Ele roda como um contêiner separado, na mesma VPS. Separado de propósito:
# precisa continuar de pé enquanto o `tumacord-server` reinicia, que é
# exatamente o momento de uma atualização.
#
# As portas 4300 e 4301 são publicadas apenas em 127.0.0.1 pelo compose. O
# proxy HTTPS é quem expõe a 4300 com o domínio de updates; a 4301 — importar,
# publicar, retirar — nunca sai do laço local.

# Quantos downloads simultâneos. A VPS divide rede, CPU e disco com o chat e
# com o TURN: sem teto, um mutirão de atualização tira a call de todo mundo.
TUMACORD_UPDATES_MAX_DOWNLOADS=6

# O commit que entra na imagem do servidor, para o `/api/health` poder prová-lo.
# `version` sozinha não prova que a atualização aconteceu: uma imagem que não
# foi reconstruída responde a versão nova do package.json com o código antigo.
# Preencha na hora de subir:
#   TUMACORD_COMMIT="$(git rev-parse HEAD)" docker compose up -d --build
TUMACORD_COMMIT=
