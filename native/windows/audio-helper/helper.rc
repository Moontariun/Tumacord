#include <winver.h>

#ifndef TUMACORD_VERSION_COMMA
#define TUMACORD_VERSION_COMMA 0,0,0,0
#endif
#ifndef TUMACORD_VERSION_TEXT
#define TUMACORD_VERSION_TEXT "0.0.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION TUMACORD_VERSION_COMMA
PRODUCTVERSION TUMACORD_VERSION_COMMA
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Tumacord"
            VALUE "FileDescription", "Tumacord — captura de áudio por aplicação"
            VALUE "FileVersion", TUMACORD_VERSION_TEXT
            VALUE "InternalName", "tumacord-audio-helper"
            VALUE "LegalCopyright", "Tumacord"
            VALUE "OriginalFilename", "tumacord-audio-helper.exe"
            VALUE "ProductName", "Tumacord"
            VALUE "ProductVersion", TUMACORD_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
