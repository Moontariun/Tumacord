{
  "name": "tumacord",
  "version": "0.9.9-2",
  "private": true,
  "type": "module",
  "description": "Chat, chamadas e compartilhamento de tela para grupos de amigos.",
  "author": "Tumacord",
  "desktopName": "tumacord",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "desktop:dev": "cross-env TUMACORD_WEB_URL=http://localhost:5173 TUMACORD_EXTERNAL_SERVER=1 electron .",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json --noEmit && esbuild server/index.ts --bundle --platform=node --format=cjs --outfile=dist-server/server-bundle.cjs",
    "build": "npm run build:web && npm run build:server && npm run build:updates",
    "start": "node dist-server/server-bundle.cjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "node --test --import tsx tests/**/*.test.ts",
    "package:dir": "npm run build && electron-builder --linux dir --publish never",
    "package:linux": "npm run build && electron-builder --linux AppImage tar.gz --publish never",
    "preview": "vite preview --host 0.0.0.0",
    "build:native:win": "powershell -NoProfile -ExecutionPolicy Bypass -File native/windows/audio-helper/build.ps1",
    "build:icon:win": "node scripts/build-windows-icon.cjs",
    "package:windows": "npm run build && npm run build:native:win && electron-builder --win nsis portable --publish never",
    "build:updates": "esbuild services/updates/src/index.ts --bundle --platform=node --format=cjs --outfile=dist-updates/service.cjs"
  },
  "dependencies": {
    "@sapphi-red/web-noise-suppressor": "^0.4.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^41.10.7",
    "electron-builder": "^26.0.12",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "br.com.tumacord.app",
    "productName": "Tumacord",
    "copyright": "Copyright © 2026 Tumacord",
    "asar": true,
    "asarUnpack": [
      "dist-server/**/*",
      "dist-web/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "dist-web/**/*",
      "dist-server/**/*",
      "assets/tumacord-logo.png",
      "assets/icons/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Network;Chat",
      "syncDesktopName": true,
      "icon": "assets/tumacord-logo.png",
      "executableName": "tumacord"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/tumacord.ico",
      "legalTrademarks": "Tumacord",
      "signtoolOptions": {
        "publisherName": "Tumacord"
      },
      "extraResources": [
        {
          "from": "native/windows/audio-helper/build/tumacord-audio-helper.exe",
          "to": "audio-helper/tumacord-audio-helper.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tumacord",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Tumacord-${version}-Setup.${ext}",
      "uninstallDisplayName": "Tumacord ${version}",
      "installerIcon": "assets/tumacord.ico",
      "uninstallerIcon": "assets/tumacord.ico",
      "installerHeaderIcon": "assets/tumacord.ico"
    },
    "portable": {
      "artifactName": "Tumacord-${version}-portable.${ext}"
    },
    "buildNumber": "2",
    "buildVersion": "0.9.9-2"
  },
  "allowScripts": {
    "electron@41.10.7": true,
    "esbuild@0.28.2": true
  }
}
