{
  "name": "tumacord",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Chat, chamadas e compartilhamento de tela para grupos de amigos.",
  "author": "Tumacord",
  "desktopName": "tumacord",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "desktop:dev": "cross-env TUMACORD_WEB_URL=http://localhost:5173 TUMACORD_EXTERNAL_SERVER=1 electron .",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json --noEmit && esbuild server/index.ts --bundle --platform=node --format=cjs --outfile=dist-server/server-bundle.cjs",
    "build": "npm run build:web && npm run build:server",
    "start": "node dist-server/server-bundle.cjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "node --test --import tsx tests/**/*.test.ts",
    "package:dir": "npm run build && electron-builder --linux dir --publish never",
    "package:linux": "npm run build && electron-builder --linux AppImage tar.gz --publish never",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@sapphi-red/web-noise-suppressor": "^0.4.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "br.com.tumacord.app",
    "productName": "Tumacord",
    "asar": true,
    "asarUnpack": [
      "dist-server/**/*",
      "dist-web/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "dist-web/**/*",
      "dist-server/**/*",
      "assets/tumacord-logo.png",
      "assets/icons/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Network;Chat",
      "syncDesktopName": true,
      "icon": "assets/tumacord-logo.png",
      "executableName": "tumacord"
    }
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "esbuild@0.28.2": true
  }
}
