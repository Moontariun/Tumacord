# Proxy HTTPS do Tumacord — exemplo versionado.
#
# Dois domínios, dois blocos. Substitua DOMINIO_CHAT e DOMINIO_UPDATES; o guia
# de instalação faz isso com `sed`, e o arquivo é versionado justamente para
# a configuração do proxy não ser reconstruída de memória a cada VPS.
#
# Por que os domínios são separados: trocar de VPS, reinstalar ou reconfigurar
# o chat não pode derrubar a capacidade de atualizar os aplicativos. E um
# servidor de chat qualquer não deve poder falar pela origem das atualizações.

# ── O chat e a web ──────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name DOMINIO_CHAT;

    # certbot escreve ssl_certificate/ssl_certificate_key aqui.

    # A call usa WebSocket. Sem estes três cabeçalhos, o socket cai em
    # polling e a voz fica com segundos de atraso.
    location / {
        proxy_pass http://127.0.0.1:4600;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Um upload de anexo grande não pode morrer no meio.
        client_max_body_size 64m;
        # A call fica quieta entre eventos; um timeout curto derruba o socket.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

# ── As atualizações ─────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name DOMINIO_UPDATES;

    # certbot escreve ssl_certificate/ssl_certificate_key aqui.

    location / {
        proxy_pass http://127.0.0.1:4300;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Um pacote de cem megabytes precisa atravessar inteiro. Sem isto, o
        # Nginx guarda a resposta em disco antes de repassar, e um download
        # grande vira um arquivo temporário do tamanho do pacote.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        client_max_body_size 1m;

        # O serviço decide o cache-control de cada resposta, e ele é
        # `private, no-store` no conteúdo privado. O proxy não sobrescreve.
    }

    # A administração NUNCA é publicada. Ela escuta em 127.0.0.1:4301 e é
    # alcançada pelo executor, que roda no próprio host. Publicá-la aqui
    # exporia importar, publicar e retirar no lugar mais exposto do sistema.
    location /admin/ {
        return 404;
    }
}

# ── HTTP → HTTPS ────────────────────────────────────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name DOMINIO_CHAT DOMINIO_UPDATES;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}
