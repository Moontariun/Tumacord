# O executor de atualizações do Tumacord.
#
# Ele existe porque o contêiner não consegue reconstruir a si mesmo: quem para,
# recria e sobe o `tumacord-server` precisa estar **fora** do processo que vai
# reiniciar. Ligar `TUMACORD_SELF_UPDATE=1` sem este serviço faz o painel
# mostrar as versões e a aplicação falhar — era a inconsistência que o
# `.env.example` anterior carregava.
#
# O que ele NÃO faz, e é por isso que ele pode existir:
#
#   · não monta o socket do Docker dentro do contêiner de chat;
#   · não oferece shell, URL arbitrária, caminho arbitrário nem comando vindo
#     do navegador;
#   · não aceita "a branch mais recente". Ele recebe um identificador de
#     release e o valida contra o catálogo aprovado antes de qualquer coisa.
#
# ANTES DE HABILITAR
#
# Os valores abaixo são exemplo e não servem para nenhuma máquina específica.
# Ajuste `WorkingDirectory`, `User` e os `Environment` para a sua instalação;
# um `WorkingDirectory` errado faz o executor operar outro projeto.
#
# A instalação é:
#   sudo install -d -o tumacord -g tumacord -m 0750 /var/lib/tumacord/executor
#   sudo install -d -o tumacord -g tumacord -m 0755 /var/lib/tumacord/run
#   sudo install -d -o tumacord -g tumacord -m 0750 /var/lib/tumacord/backups
#   sudo cp packaging/servidor/tumacord-executor.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now tumacord-executor
#
# Na primeira subida ele gera o segredo em
# `/var/lib/tumacord/executor/executor.token`, com permissão 0600. Esse segredo
# **não é impresso** — nem no journal, que vai inteiro para dentro de um relato
# de problema. Leia-o do arquivo e ponha-o no `.env` do projeto como
# `TUMACORD_EXECUTOR_TOKEN`, junto com
# `COMPOSE_FILE=docker-compose.yml:docker-compose.executor.yml`.
#
# Enquanto esta unidade não estiver de pé, `TUMACORD_SELF_UPDATE` fica em 0 e a
# atualização é o procedimento de docs/atualizacao-servidor.md. Ligar a variável
# sem o executor faz o painel mostrar as versões e a aplicação falhar.

[Unit]
Description=Executor de atualizações do Tumacord
Documentation=file:///opt/tumacord/docs/atualizacao-servidor.md
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
# O diretório do projeto desta instalação.
WorkingDirectory=/opt/tumacord
Environment=TUMACORD_PROJETO=tumacord
# Onde o estado dos trabalhos vive. Fora do checkout, que é descartável.
Environment=TUMACORD_EXECUTOR_STATE=/var/lib/tumacord/executor
# O chat fala com o executor por este socket, montado dentro do contêiner por
# docker-compose.executor.yml. Um socket não é alcançável pela rede. O
# diretório é outro que o do estado de propósito: o executor recusa subir com o
# socket ao lado do segredo.
Environment=TUMACORD_EXECUTOR_SOCKET=/var/lib/tumacord/run/executor.sock
# A cópia que antecede cada aplicação. Sem destino, o painel não aplica nada.
Environment=TUMACORD_BACKUP_DIR=/var/lib/tumacord/backups
# A administração do serviço de atualizações, também no laço local.
Environment=TUMACORD_UPDATES_ADMIN=http://127.0.0.1:4301
ExecStart=/usr/bin/node /opt/tumacord/tools/tumacordctl/executor.mjs

# Permissões limitadas. O executor precisa do Docker e do diretório do
# projeto; não precisa de mais nada, e o que ele não precisa fica fechado.
User=tumacord
Group=docker
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/tumacord /opt/tumacord
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

Restart=on-failure
RestartSec=5s
# O executor pode ser reiniciado no meio de um trabalho. O estado dos
# trabalhos é persistido justamente para ele saber onde parou.
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
